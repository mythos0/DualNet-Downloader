<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>4.1.0</Version>
    <AssemblyName>DualNet.App</AssemblyName>
    <RootNamespace>DualNet.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Description>DualNet Downloader — full Chromium browser (CEF) with a dual-NIC download manager, per-tab proxies and preinstalled uBlock Origin</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- CEF native binaries must stay on disk next to the exe: publish as a folder + zip -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.WPF.NETCore" Version="138.0.340" />
    <PackageReference Include="Sentry" Version="6.12.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DualNet.Core\DualNet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\Extensions\*.zip" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.png" />
  </ItemGroup>

</Project>
