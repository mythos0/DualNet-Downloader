<UserControl x:Class="DualNet.App.Views.NewTabPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="NL" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource BrushHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer Background="{DynamicResource BrushPage}" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="0,60,0,40" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                <Image Source="/Assets/app.png" Width="44" Height="44"/>
                <TextBlock Text="DualNet" FontSize="30" FontWeight="SemiBold" Margin="10,0,0,0"
                           Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Dual-network browser + download manager" HorizontalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,22"/>

            <!-- DuckDuckGo search -->
            <Border CornerRadius="22" Background="{DynamicResource BrushField}" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" Padding="16,0" Height="44">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔎" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                             FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource BrushText}"
                             KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"
                             ToolTip="Search with DuckDuckGo or type a URL">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Resources>
                                    <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" Stretch="None">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="Search DuckDuckGo or enter address" FontSize="14"
                                                       Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,3"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Grid.Column="2" Text="DuckDuckGo" FontSize="10" Foreground="{DynamicResource BrushTextDim}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- quick links -->
            <UniformGrid Columns="4" Margin="0,26,0,0">
                <Button Style="{StaticResource NL}" Click="Quick_Click" Tag="https://duckduckgo.com" Content="🦆&#x0a;DuckDuckGo"/>
                <Button Style="{StaticResource NL}" Click="Quick_Click" Tag="https://github.com" Content="🐙&#x0a;GitHub"/>
                <Button Style="{StaticResource NL}" Click="Quick_Click" Tag="https://www.wikipedia.org" Content="📚&#x0a;Wikipedia"/>
                <Button Style="{StaticResource NL}" Click="Quick_Click" Tag="https://news.ycombinator.com" Content="📰&#x0a;Hacker News"/>
            </UniformGrid>

            <!-- add download -->
            <Border CornerRadius="10" Background="{DynamicResource BrushCard}" Padding="14" Margin="0,30,0,0">
                <StackPanel>
                    <TextBlock Text="Add download" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                    <TextBlock Text="Runs through the DualNet engine — pick the network in the toolbar, then start." FontSize="11"
                               Foreground="{DynamicResource BrushTextDim}" Margin="0,2,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AddUrlBox" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Download" Padding="14,5" Margin="8,0,0,0"
                                Background="{DynamicResource BrushAccent}" Foreground="White"
                                BorderThickness="0" Click="AddDownload_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- recent -->
            <TextBlock Text="Recent" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,26,0,6"/>
            <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="8,5" Margin="0,2" Background="{DynamicResource BrushRow}" Cursor="Hand"
                                MouseUp="Recent_Click" ToolTip="{Binding Url}">
                            <Grid>
                                <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                                <TextBlock Text="{Binding HostText}" FontSize="10" Foreground="{DynamicResource BrushTextDim}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
