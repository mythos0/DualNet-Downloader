<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualNet.App.ViewModels"
        xmlns:views="using:DualNet.App.Views"
        x:Class="DualNet.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="DualNet Downloader — Ethernet + Wi-Fi combined"
        Background="{DynamicResource DnChromeContentBrush}"
        Width="1280" Height="800" MinWidth="840" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- ================= Chrome tab strip ================= -->
    <Border Grid.Row="0" Background="{DynamicResource DnChromeStripBrush}"
            Height="40" Padding="8,0,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="newTabBtn" Content="＋" Margin="6,5,12,0"
                Command="{Binding NewTabCommand}" ToolTip.Tip="New tab  (Ctrl+T)" />
        <ListBox Classes="chromeTabs" ItemsSource="{Binding Tabs}"
                 SelectedIndex="{Binding SelectedTabIndex}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DownloadTabViewModel">
              <Panel>
                <StackPanel Orientation="Horizontal" Spacing="7" Margin="13,0,26,0"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding Glyph}" FontSize="11.5" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Title}" />
                </StackPanel>
                <Button Classes="tabClose" Content="✕" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,6,0"
                        IsVisible="{Binding !IsHistoryTab}"
                        Click="OnCloseTabClick" ToolTip.Tip="Close tab  (Ctrl+W)" />
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ================= Chrome toolbar ================= -->
    <Border Grid.Row="1" Background="{DynamicResource DnChromeToolbarBrush}"
            BorderBrush="{DynamicResource DnChromeStrokeBrush}" BorderThickness="0,0,0,1"
            Padding="8,6">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">

        <Button Grid.Column="0" Classes="chromeBtn" Content="◀"
                Command="{Binding SelectedTab.Browser.GoBackCommand}"
                IsEnabled="{Binding SelectedTab.Browser.CanGoBack}" ToolTip.Tip="Back" />
        <Button Grid.Column="1" Classes="chromeBtn" Content="▶"
                Command="{Binding SelectedTab.Browser.GoForwardCommand}"
                IsEnabled="{Binding SelectedTab.Browser.CanGoForward}" ToolTip.Tip="Forward" />
        <Panel Grid.Column="2">
          <Button Classes="chromeBtn" Content="✕" Command="{Binding SelectedTab.Browser.StopCommand}"
                  IsVisible="{Binding SelectedTab.Browser.IsLoading}" ToolTip.Tip="Stop loading" />
          <Button Classes="chromeBtn" Content="↻" Command="{Binding SelectedTab.Browser.ReloadCommand}"
                  IsVisible="{Binding !SelectedTab.Browser.IsLoading}" ToolTip.Tip="Reload" />
        </Panel>
        <Button Grid.Column="3" Classes="chromeBtn" Content="⌂"
                Command="{Binding SelectedTab.Browser.GoHomeCommand}" ToolTip.Tip="Home" Margin="4,0,0,0" />

        <!-- Omnibox -->
        <Border Grid.Column="4" Classes="omnibox" Margin="8,0">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Text="🔒" FontSize="11" VerticalAlignment="Center" Margin="2,0,7,0" />
            <AutoCompleteBox x:Name="Omnibox" Grid.Column="1" Classes="omniInput"
                             Watermark="Search or type a URL  (Ctrl+L)"
                             Text="{Binding SelectedTab.Browser.AddressText}"
                             ItemsSource="{Binding SelectedTab.Browser.Suggestions}"
                             FilterMode="None" MinimumPrefixLength="2"
                             MaxDropDownHeight="280"
                             TextChanged="OnAddressTextChanged"
                             KeyDown="OnAddressKeyDown" />
            <Button Grid.Column="2" Classes="tabStar" Content="★"
                    IsVisible="{Binding SelectedTab.Browser.IsBookmarked}"
                    Command="{Binding SelectedTab.Browser.ToggleBookmarkCommand}"
                    ToolTip.Tip="Bookmarked — click to remove" />
            <Button Grid.Column="3" Classes="tabStar" Content="☆"
                    IsVisible="{Binding !SelectedTab.Browser.IsBookmarked}"
                    Command="{Binding SelectedTab.Browser.ToggleBookmarkCommand}"
                    ToolTip.Tip="Bookmark this page" />
          </Grid>
        </Border>

        <!-- Downloads shelf toggle + active badge -->
        <Panel Grid.Column="5">
          <Button Classes="chromeBtn" Content="⤓" Command="{Binding ToggleShelfCommand}"
                  ToolTip.Tip="Show or hide the downloads shelf" />
          <Border Classes="dlBadge" IsVisible="{Binding HasActiveDownloads}">
            <TextBlock Text="{Binding ActiveDownloadCount}" />
          </Border>
        </Panel>

        <!-- Networks flyout -->
        <Button Grid.Column="6" Classes="chromeBtn" Content="🌐" Margin="4,0,0,0" ToolTip.Tip="Networks">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <Border Width="440" Background="{DynamicResource DnChromeMenuBrush}"
                      BorderBrush="{DynamicResource DnChromeStrokeBrush}" BorderThickness="1"
                      CornerRadius="10" Padding="14,12">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                    <TextBlock Text="Networks" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                      <Button Classes="mini" Content="＋ provider" Command="{Binding AddManualProviderCommand}"
                              ToolTip.Tip="Add a manual network provider (VPN, virtual NIC…)" />
                      <Button Classes="mini" Content="↻ rescan" Command="{Binding RefreshNetworksCommand}"
                              ToolTip.Tip="Rescan networks now" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding AdaptersSummary}" Classes="hint" Margin="0,0,0,8" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Adapters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AdapterChipViewModel">
                        <Border Classes="chip" ToolTip.Tip="{Binding Tooltip}" Opacity="{Binding ChipOpacity}"
                                Margin="0,0,0,6" HorizontalAlignment="Stretch">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <Ellipse Width="9" Height="9" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
                              <TextBlock Text="＋" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                                         IsVisible="{Binding IsManual}" ToolTip.Tip="Manual network provider" />
                              <TextBlock Text="⦸" FontSize="11" VerticalAlignment="Center"
                                         IsVisible="{Binding !IsOnline}" />
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding TypeName}" Classes="hint" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding IPv4Address}" Classes="hint" VerticalAlignment="Center" />
                              <TextBlock Text="offline" Classes="hint" VerticalAlignment="Center" IsVisible="{Binding !IsOnline}" />
                              <TextBlock Text="{Binding SpeedText}" Classes="hint" VerticalAlignment="Center"
                                         IsVisible="{Binding HasSpeed}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="toolbtn" Content="✕" Padding="4,0" MinWidth="18" MinHeight="18"
                                    Height="18" FontSize="9" Background="Transparent" BorderThickness="0"
                                    IsVisible="{Binding IsManual}" Command="{Binding RemoveProviderCommand}"
                                    ToolTip.Tip="Remove this manual provider" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>

        <!-- ⋮ menu -->
        <Button Grid.Column="7" Classes="chromeBtn" Content="⋮" Margin="4,0,0,0" FontSize="16" ToolTip.Tip="Menu">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="New tab" InputGesture="Ctrl+T" Command="{Binding NewTabCommand}" />
              <MenuItem Header="Toggle downloads shelf" Command="{Binding ToggleShelfCommand}" />
              <Separator />
              <MenuItem Header="Pause all downloads" Command="{Binding PauseAllEverywhereCommand}" />
              <MenuItem Header="Resume all" Command="{Binding ResumeAllEverywhereCommand}" />
              <MenuItem Header="Retry failed downloads" Command="{Binding RetryFailedEverywhereCommand}" />
              <Separator />
              <MenuItem Header="Clipboard monitor" ToggleType="CheckBox" IsChecked="{Binding ClipboardMonitor}" />
              <MenuItem Header="Shut down when downloads finish" ToggleType="CheckBox" IsChecked="{Binding ShutdownWhenComplete}" />
              <Separator />
              <MenuItem Header="Speed test (this tab)" Command="{Binding SpeedTestSelectedCommand}" />
              <MenuItem Header="Export history (CSV)" Command="{Binding ExportHistoryCommand}" />
              <MenuItem Header="Open downloads folder" Command="{Binding OpenDownloadsFolderCommand}" />
              <Separator />
              <MenuItem Header="Theme">
                <MenuItem Header="System" Command="{Binding SetThemeCommand}" CommandParameter="system" />
                <MenuItem Header="Dark" Command="{Binding SetThemeCommand}" CommandParameter="dark" />
                <MenuItem Header="Light" Command="{Binding SetThemeCommand}" CommandParameter="light" />
              </MenuItem>
              <Separator />
              <MenuItem Header="Settings" Click="OnOpenSettings" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- ================= Tab content ================= -->
    <Border Grid.Row="2" Background="{DynamicResource DnChromeContentBrush}">
      <ContentControl Content="{Binding SelectedTab}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:DownloadTabViewModel">
            <views:DownloadTabView />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Border>

    <!-- ================= Status bar ================= -->
    <Border Grid.Row="3" Background="{DynamicResource DnChromeToolbarBrush}"
            BorderBrush="{DynamicResource DnChromeStrokeBrush}" BorderThickness="0,1,0,0"
            Padding="12,4">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <TextBlock Text="{Binding ScheduleStatus}" Classes="ok" FontSize="11"
                     IsVisible="{Binding ShowScheduleStatus}" MaxWidth="360"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding ShutdownHint}" Classes="error" FontSize="11"
                     IsVisible="{Binding ShowShutdownHint}" MaxWidth="430" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Clipboard link banner -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    IsVisible="{Binding HasClipboardBanner}" Margin="0,0,16,0">
          <TextBlock Text="📋" VerticalAlignment="Center" FontSize="11" />
          <TextBlock Text="{Binding ClipboardBannerText}" Classes="hint" VerticalAlignment="Center"
                     MaxWidth="340" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="A download link was copied to the clipboard" />
          <Button Classes="accent" Padding="10,3" FontSize="11" Content="⤓ Download"
                  Command="{Binding GoClipboardUrlCommand}"
                  ToolTip.Tip="Download the copied link in the current tab" />
          <Button Classes="tabClose" Content="✕" Command="{Binding DismissClipboardCommand}" ToolTip.Tip="Dismiss" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="total:" Classes="hint" VerticalAlignment="Center" FontSize="11" />
          <TextBlock Text="{Binding TotalSpeedText}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
          <TextBlock Text="v2.0.0" Classes="hint" VerticalAlignment="Center" FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
