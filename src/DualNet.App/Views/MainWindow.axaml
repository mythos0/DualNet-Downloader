<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualNet.App.ViewModels"
        xmlns:views="using:DualNet.App.Views"
        x:Class="DualNet.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="DualNet Downloader — Ethernet + Wi-Fi combined"
        Background="{DynamicResource DnBgBrush}"
        TransparencyLevelHint="AcrylicBlur"
        Width="1200" Height="780" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ================= Header ================= -->
    <Border Grid.Row="0" Classes="dnToolbar">
      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="12"
                    VerticalAlignment="Center">
          <Border Classes="logo">
            <TextBlock Text="⇊" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="DualNet Downloader" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="Ethernet + Wi-Fi combined downloading" Classes="hint" />
          </StackPanel>
        </StackPanel>

        <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Adapters}"
                      HorizontalAlignment="Center" Margin="12,0" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AdapterChipViewModel">
              <Panel>
                <Border Classes="chip" ToolTip.Tip="{Binding Tooltip}" Opacity="{Binding ChipOpacity}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="9" Height="9" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="＋" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                                   IsVisible="{Binding IsManual}"
                                   ToolTip.Tip="Manual network provider" />
                        <TextBlock Text="⦸" FontSize="11" VerticalAlignment="Center"
                                   IsVisible="{Binding !IsOnline}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding TypeName}" Classes="hint" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding IPv4Address}" Classes="hint" />
                        <TextBlock Text="offline" Classes="hint" IsVisible="{Binding !IsOnline}" />
                        <TextBlock Text="{Binding SpeedText}" Classes="hint"
                                   IsVisible="{Binding HasSpeed}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Button Content="✕" Padding="3,0" MinWidth="16" MinHeight="16" Height="16"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                        Background="Transparent" BorderThickness="0" FontSize="9"
                        IsVisible="{Binding IsManual}" Command="{Binding RemoveProviderCommand}"
                        ToolTip.Tip="Remove this manual provider" />
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
          <ToggleButton Classes="toolbtn" Content="📋" IsChecked="{Binding ClipboardMonitor}"
                        ToolTip.Tip="Watch the clipboard for copied download links" />
          <ToggleButton Classes="toolbtn" Content="⏻" IsChecked="{Binding ShutdownWhenComplete}"
                        ToolTip.Tip="Shut the PC down when all downloads finish" />
          <ComboBox SelectedIndex="{Binding ThemeMode}" MinWidth="116"
                    VerticalAlignment="Center" ToolTip.Tip="Theme">
            <ComboBoxItem Content="System theme" />
            <ComboBoxItem Content="Dark" />
            <ComboBoxItem Content="Light" />
          </ComboBox>
          <Button Classes="toolbtn" Content="＋"
                  Command="{Binding AddManualProviderCommand}"
                  ToolTip.Tip="Add a manual network provider — for networks the auto-scan misses (VPN, virtual NIC, multi-IP…)" />
          <Button Classes="toolbtn" Content="↻"
                  Command="{Binding RefreshNetworksCommand}"
                  ToolTip.Tip="Rescan networks now — also happens automatically every 5 s" />
          <Button Classes="toolbtn" Content="⚙" Click="OnOpenSettings" ToolTip.Tip="Settings" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="{Binding AdaptersSummary}" Classes="hint" Margin="0,7,0,0"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <!-- ================= Tabs ================= -->
    <TabControl Grid.Row="1" ItemsSource="{Binding Tabs}"
                SelectedIndex="{Binding SelectedTabIndex}" Margin="16,12,16,0"
                Background="Transparent">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DownloadTabViewModel">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Glyph}" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TabSpeedText}" FontSize="11" VerticalAlignment="Center"
                       IsVisible="{Binding IsDownloadTab}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="vm:DownloadTabViewModel">
          <views:DownloadTabView />
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>

    <!-- ================= Status bar ================= -->
    <Border Grid.Row="2" Classes="dnStatusBar" Margin="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <TextBlock Text="{Binding ScheduleStatus}" Classes="ok"
                     IsVisible="{Binding ShowScheduleStatus}" MaxWidth="360"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding ShutdownHint}" Classes="error"
                     IsVisible="{Binding ShowShutdownHint}" MaxWidth="430"
                     TextWrapping="Wrap" />
        </StackPanel>

        <!-- Clipboard link banner -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    IsVisible="{Binding HasClipboardBanner}" Margin="0,0,16,0">
          <TextBlock Text="📋" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ClipboardBannerText}" Classes="hint" VerticalAlignment="Center"
                     MaxWidth="340" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="A download link was copied to the clipboard" />
          <Button Classes="accent" Padding="12,5" FontSize="12" Content="⤓ Download"
                  Command="{Binding GoClipboardUrlCommand}"
                  ToolTip.Tip="Download the copied link in the current tab" />
          <Button Classes="toolbtn" Padding="8,4" Content="✕" MinWidth="0"
                  Command="{Binding DismissClipboardCommand}" ToolTip.Tip="Dismiss" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Button Classes="mini" Content="⬇ export history" Command="{Binding ExportHistoryCommand}"
                  ToolTip.Tip="Save all history entries as CSV into the download folder" />
          <TextBlock Text="total:" Classes="hint" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TotalSpeedText}" FontWeight="Bold" FontSize="13"
                     VerticalAlignment="Center" />
          <TextBlock Text="v1.2.0" Classes="hint" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
