<UserControl x:Class="DualNet.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer Background="{DynamicResource BrushPage}" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Margin="24,18" HorizontalAlignment="Left">

            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,14"/>

            <!-- General -->
            <Border CornerRadius="10" Background="{DynamicResource BrushCard}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Search engine" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="SearchEngineBox" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                  SelectionChanged="SearchEngine_SelectionChanged"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Theme" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="Theme_SelectionChanged">
                            <ComboBoxItem Content="Follow system"/>
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="Light"/>
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Download folder" Style="{StaticResource Label}"/>
                        <DockPanel Grid.Column="1">
                            <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,4" Margin="8,0,0,0" Click="BrowseDir_Click"/>
                            <TextBox x:Name="DownloadDirBox" Height="28" FontSize="12" VerticalContentAlignment="Center"
                                     LostFocus="DownloadDir_LostFocus"/>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Downloads -->
            <Border CornerRadius="10" Background="{DynamicResource BrushCard}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Downloads" Style="{StaticResource SectionTitle}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Max concurrent downloads" Style="{StaticResource Label}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="MaxConcurrentBox" Width="70" Height="28" FontSize="12" LostFocus="MaxConcurrent_LostFocus"/>
                            <TextBlock Style="{StaticResource Hint}" Text=" 1–10; extra downloads wait in queue" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Max connections / download" Style="{StaticResource Label}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="MaxConnBox" Width="70" Height="28" FontSize="12" LostFocus="MaxConn_LostFocus"/>
                            <TextBlock Style="{StaticResource Hint}" Text=" 4–64 segment connections (adaptive scaling cap)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Speed limit (KB/s, 0 = off)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="SpeedLimitBox" Width="70" Height="28" FontSize="12" LostFocus="SpeedLimit_LostFocus"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Organize by category" Style="{StaticResource Label}"/>
                        <CheckBox x:Name="OrganizeCheck" VerticalAlignment="Center" Checked="Organize_Changed" Unchecked="Organize_Changed"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Adaptive scaling" Style="{StaticResource Label}"/>
                        <CheckBox x:Name="AdaptiveCheck" VerticalAlignment="Center" IsChecked="True" IsEnabled="False"
                                  ToolTip="Always on: splits segments and hands work to idle NICs while throughput improves"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Browser -->
            <Border CornerRadius="10" Background="{DynamicResource BrushCard}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Browser" Style="{StaticResource SectionTitle}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Bookmarks bar" Style="{StaticResource Label}"/>
                        <CheckBox x:Name="BookmarksBarCheck" VerticalAlignment="Center" Checked="BookmarksBar_Changed" Unchecked="BookmarksBar_Changed"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Restore session on launch" Style="{StaticResource Label}"/>
                        <CheckBox x:Name="RestoreCheck" VerticalAlignment="Center" Checked="Restore_Changed" Unchecked="Restore_Changed"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Default download network" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="DefaultNicBox" Grid.Column="1" Width="280" HorizontalAlignment="Left"
                                  SelectionChanged="DefaultNic_SelectionChanged">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Tip: every tab has its own network selector beside the proxy globe in the toolbar — downloads started from that tab default to it."/>
                </StackPanel>
            </Border>

            <!-- Privacy -->
            <Border CornerRadius="10" Background="{DynamicResource BrushCard}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Privacy" Style="{StaticResource SectionTitle}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Block third-party cookies" Style="{StaticResource Label}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox x:Name="ThirdPartyCheck" VerticalAlignment="Center" Checked="ThirdParty_Changed" Unchecked="ThirdParty_Changed"/>
                            <TextBlock Style="{StaticResource Hint}" Text="  (applies after restart)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="Clear browsing history" HorizontalAlignment="Left" Padding="12,5" Margin="0,6" Click="ClearHistory_Click"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="uBlock Origin (preinstalled) blocks ads and trackers per tab; private tabs (Ctrl+Shift+N) keep an in-memory profile that vanishes on close."/>
                </StackPanel>
            </Border>

            <!-- AI Agent -->
            <Border CornerRadius="10" Background="{DynamicResource BrushCard}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="AI Agent (local)" Style="{StaticResource SectionTitle}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Ollama server URL" Style="{StaticResource Label}"/>
                        <TextBox x:Name="OllamaUrlBox" Height="28" FontSize="12" VerticalContentAlignment="Center" LostFocus="OllamaUrl_LostFocus"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Model" Style="{StaticResource Label}"/>
                        <TextBox x:Name="AgentModelBox" Height="28" FontSize="12" VerticalContentAlignment="Center" LostFocus="AgentModel_LostFocus"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Unload model after idle (s)" Style="{StaticResource Label}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="IdleUnloadBox" Width="70" Height="28" FontSize="12" LostFocus="IdleUnload_LostFocus"/>
                            <TextBlock Style="{StaticResource Hint}" Text=" frees the model's RAM automatically (min 30s)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Get the runtime from ollama.com, then run: ollama pull qwen3.5:2b — everything runs locally; no data leaves your machine."/>
                </StackPanel>
            </Border>

            <!-- Telemetry -->
            <Border CornerRadius="10" Background="{DynamicResource BrushCard}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Telemetry" Style="{StaticResource SectionTitle}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Send crash reports (Sentry)" Style="{StaticResource Label}"/>
                        <CheckBox x:Name="SentryCheck" VerticalAlignment="Center" Checked="Sentry_Changed" Unchecked="Sentry_Changed"/>
                    </Grid>
                    <Button Content="Send test event" HorizontalAlignment="Left" Padding="12,5" Margin="0,6" Click="TestEvent_Click"/>
                    <TextBlock x:Name="TestEventResult" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
