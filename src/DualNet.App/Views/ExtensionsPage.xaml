<UserControl x:Class="DualNet.App.Views.ExtensionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BrushPage}" Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Extensions" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
            <Button Content="Open extensions folder" Padding="12,5" Margin="16,0,0,0" Click="OpenFolder_Click"/>
        </StackPanel>
        <TextBlock Grid.Row="1" FontSize="11" Foreground="{DynamicResource BrushTextDim}" TextWrapping="Wrap" MaxWidth="760" Margin="0,0,0,10"
                   Text="DualNet runs real Chromium (CEF), so it loads genuine Chrome extensions. uBlock Origin and uBlock Origin Lite are bundled; drop any unpacked extension (folder containing manifest.json) into the extensions folder to install it. Enabled changes apply after restarting DualNet."/>
        <TextBlock Grid.Row="2" FontSize="11" Foreground="{DynamicResource BrushWarn}" Margin="0,0,0,10"
                   Text="Changing the checkboxes below requires a restart to take effect."/>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ExtList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" Background="{DynamicResource BrushCard}" Padding="14" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource BrushAccentSoft}">
                                    <TextBlock Text="🧩" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding TagText}" FontSize="10" Foreground="{DynamicResource BrushAccent}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                          IsChecked="{Binding EnabledCheckbox, Mode=OneWay}" Checked="Ext_Changed" Unchecked="Ext_Changed"
                                          ToolTip="Load on startup"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
