<UserControl x:Class="DualNet.App.Views.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BrushPage}" Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Downloads" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
            <TextBlock Text="{Binding AggregateSpeedText, StringFormat=▾{0} total}" FontSize="13"
                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>

        <!-- add url -->
        <Border Grid.Row="1" CornerRadius="8" Background="{DynamicResource BrushCard}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlBox" Height="32" FontSize="13" VerticalContentAlignment="Center"
                         KeyDown="UrlBox_KeyDown" ToolTip="Paste a direct link (http/https)"/>
                <Button Grid.Column="1" Content="Download" Height="32" Padding="16,0" Margin="8,0,0,0"
                        Background="{DynamicResource BrushAccent}" Foreground="White" BorderThickness="0"
                        Click="Add_Click"/>
                <Button Grid.Column="2" Content="Pause all" Height="32" Padding="12,0" Margin="8,0,0,0" Click="PauseAll_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Downloads}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" Background="{DynamicResource BrushCard}" Padding="14" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis"
                                               MaxWidth="520" ToolTip="{Binding Url}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="12"
                                               Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ProgressBar Grid.Row="1" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8"
                                             Background="{DynamicResource BrushHover}" Foreground="{DynamicResource BrushAccent}"/>
                                <Grid Grid.Row="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource BrushTextDim}"/>
                                        <TextBlock Text="{Binding EtaText}" FontSize="11" Foreground="{DynamicResource BrushTextDim}" Margin="10,0,0,0"/>
                                        <TextBlock Text="{Binding NetworkText}" FontSize="11" Foreground="{DynamicResource BrushTextDim}" Margin="10,0,0,0"/>
                                        <TextBlock Text="{Binding ScopeLabel, StringFormat=via {0}}" FontSize="11"
                                                   Foreground="{DynamicResource BrushWarn}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Pause" FontSize="11" Padding="8,3" Margin="2,0" Command="{Binding DataContext.PauseDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <Button Content="Resume" FontSize="11" Padding="8,3" Margin="2,0" Command="{Binding DataContext.ResumeDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <Button Content="Cancel" FontSize="11" Padding="8,3" Margin="2,0" Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <Button Content="Open" FontSize="11" Padding="8,3" Margin="2,0" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <Button Content="Folder" FontSize="11" Padding="8,3" Margin="2,0" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <Button Content="Copy URL" FontSize="11" Padding="8,3" Margin="2,0" Command="{Binding DataContext.CopyUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <Button Content="Remove" FontSize="11" Padding="8,3" Margin="2,0" Command="{Binding DataContext.RemoveDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
