<UserControl x:Class="DualNet.App.Views.AgentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="AgentBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BrushPage}" Margin="20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✨ Agent" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                <Border Style="{StaticResource Chip}" Margin="14,0,0,0"
                        Background="{DynamicResource BrushAccentSoft}">
                    <TextBlock x:Name="StatusPill" Text="{Binding StatusText}" FontSize="11"
                               Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource AgentBtn}" Content="Free RAM now" Click="UnloadNow_Click"
                        ToolTip="Unloads the local model from memory and trims the app's working set"/>
                <Button Style="{StaticResource AgentBtn}" Content="↻" Click="RefreshStatus_Click" Margin="6,0,0,0"
                        ToolTip="Re-check Ollama / model availability"/>
            </StackPanel>
        </DockPanel>

        <!-- input -->
        <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource BrushCard}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="What should the agent do?" FontSize="12" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TaskBox" Height="52" FontSize="13" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             Text="{Binding TaskInput, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="TaskBox_KeyDown" AcceptsReturn="False"
                             ToolTip="e.g. Find the official docs for react, vue and svelte · Compare these laptops in a table · Download all PDFs from this page"/>
                    <Button Grid.Column="1" Content="Run ✨" Style="{StaticResource AgentBtn}" Margin="8,0,0,0"
                            Background="{DynamicResource BrushAccent}" Foreground="White"
                            Command="{Binding RunTaskCommand}" VerticalAlignment="Top"/>
                    <Button Grid.Column="2" Content="Stop" Style="{StaticResource AgentBtn}" Margin="6,0,0,0"
                            Command="{Binding StopCommand}" VerticalAlignment="Top"/>
                </Grid>
                <TextBlock FontSize="10" Foreground="{DynamicResource BrushTextDim}" Margin="0,6,0,0"
                           Text="The agent reads pages, opens tabs, extracts tables and queues downloads by itself. Purchases, form submissions and deletions always ask for your confirmation first."/>
            </StackPanel>
        </Border>

        <!-- transcript + results -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- transcript -->
            <Border CornerRadius="10" Background="{DynamicResource BrushCard}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Transcript}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" Margin="0,1" CornerRadius="6"
                                        Background="{DynamicResource BrushRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" MaxWidth="520"
                                                       Foreground="{DynamicResource BrushText}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource BrushTextDim}"
                                                       TextWrapping="Wrap" MaxWidth="520"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- results -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- confirmation -->
                <Border x:Name="ConfirmPanel" CornerRadius="10" Background="{DynamicResource BrushWarn}" Padding="12"
                        Visibility="{Binding ShowConfirmation, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Confirm this step" FontSize="13" FontWeight="SemiBold" Foreground="#202124"/>
                        <TextBlock Text="{Binding PendingActionText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" Foreground="#202124"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Approve" Style="{StaticResource AgentBtn}" Background="#ffffff" Command="{Binding ConfirmYesCommand}"/>
                            <Button Content="Skip step" Style="{StaticResource AgentBtn}" Margin="6,0,0,0" Background="#ffffff" Command="{Binding ConfirmNoCommand}"/>
                            <Button Content="Cancel task" Style="{StaticResource AgentBtn}" Margin="6,0,0,0" Command="{Binding ConfirmCancelCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- table result -->
                <TextBlock Grid.Row="0" Text="Extracted table" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}" Margin="0,0,0,4"
                           Visibility="{Binding HasTable, Converter={StaticResource BoolToVis}}"/>
                <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource BrushCard}" Padding="6"
                        Visibility="{Binding HasTable, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                    <DataGrid ItemsSource="{Binding ResultTable}" AutoGenerateColumns="True" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                              Background="Transparent" RowBackground="Transparent" FontSize="11"
                              Foreground="{DynamicResource BrushText}" HorizontalGridLinesBrush="{DynamicResource BrushBorder}"/>
                </Border>

                <!-- links result -->
                <TextBlock Grid.Row="2" Text="Links found" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}" Margin="0,0,0,4"
                           Visibility="{Binding HasLinks, Converter={StaticResource BoolToVis}}"/>
                <ScrollViewer Grid.Row="3" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ResultLinks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Background="{DynamicResource BrushRow}" Padding="8,5" Margin="0,2">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                                            <TextBlock Text="{Binding Url}" FontSize="10" Foreground="{DynamicResource BrushTextDim}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Button Content="Open" FontSize="10" Padding="6,2" Margin="2,0" Command="{Binding OpenCommand}"/>
                                            <Button Content="⬇" FontSize="10" Padding="6,2" Command="{Binding DownloadCommand}" ToolTip="Download"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- footer hint -->
        <TextBlock Grid.Row="3" FontSize="10" Foreground="{DynamicResource BrushTextDim}" Margin="0,8,0,0"
                   Text="Powered by a local Ollama model (qwen3.5:2b by default) — nothing leaves your machine. The model unloads from RAM automatically when idle."/>
    </Grid>
</UserControl>
