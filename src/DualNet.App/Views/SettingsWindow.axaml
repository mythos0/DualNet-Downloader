<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualNet.App.ViewModels"
        x:Class="DualNet.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        x:CompileBindings="True"
        Title="DualNet — Settings"
        Width="560" MinHeight="500" SizeToContent="Height" CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DnBgBrush}">

  <ScrollViewer MaxHeight="640">
    <StackPanel Margin="24,20,24,20" Spacing="10">

      <TextBlock Text="Settings" FontWeight="Bold" FontSize="18" />

      <TextBlock Text="Download folder" Classes="sectionTitle" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Text="{Binding DownloadDirectory}" />
        <Button Grid.Column="1" Content="Browse…" Classes="toolbtn" Margin="8,0,0,0" Click="OnBrowse" />
      </Grid>

      <TextBlock Text="Maximum simultaneous downloads" Classes="sectionTitle" />
      <NumericUpDown Minimum="1" Maximum="10" Increment="1" Value="{Binding MaxConcurrent}" />

      <TextBlock Text="Retries per segment (auto-retry on network hiccups)" Classes="sectionTitle" />
      <NumericUpDown Minimum="1" Maximum="20" Increment="1" Value="{Binding RetryCount}" />

      <TextBlock Text="Speed limit — KB/s, combined for all adapters (0 = unlimited)" Classes="sectionTitle" />
      <NumericUpDown Minimum="0" Maximum="1048576" Increment="128" Value="{Binding SpeedLimitKbps}"
                     ToolTip.Tip="Caps the total download throughput of every job and adapter" />

      <TextBlock Text="Proxy" Classes="sectionTitle" />
      <ComboBox SelectedIndex="{Binding ProxyModeIndex}" MinWidth="220"
                ToolTip.Tip="Applies to every download connection">
        <ComboBoxItem Content="Direct connection (no proxy)" />
        <ComboBoxItem Content="Use system proxy" />
        <ComboBoxItem Content="Manual proxy" />
      </ComboBox>
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ProxyModeIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}">
        <TextBox Text="{Binding ProxyHost}" Watermark="proxy host, e.g. 127.0.0.1" />
        <NumericUpDown Grid.Column="1" Minimum="1" Maximum="65535" Increment="1"
                       Value="{Binding ProxyPort}" Width="130" Margin="8,0,0,0" />
      </Grid>

      <TextBlock Text="Scheduler (IDM-style daily window)" Classes="sectionTitle" />
      <CheckBox Content="Only download inside the time window" IsChecked="{Binding ScheduleEnabled}" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ScheduleEnabled}">
        <TextBox Text="{Binding ScheduleStartText}" Watermark="start HH:mm" Width="130" />
        <TextBlock Text="→" VerticalAlignment="Center" />
        <TextBox Text="{Binding ScheduleStopText}" Watermark="stop HH:mm" Width="130" />
        <TextBlock Text="Overnight windows (23:00 → 07:00) are supported." Classes="hint"
                   VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Text="Files &amp; behaviour" Classes="sectionTitle" />
      <CheckBox Content="Organize finished downloads into category sub-folders"
                IsChecked="{Binding OrganizeByCategory}"
                ToolTip.Tip="Video/, Compressed/, Programs/, Documents/…" />
      <CheckBox Content="Play a sound when a download completes" IsChecked="{Binding CompletionSound}" />

      <TextBlock Text="Integration" Classes="sectionTitle" />
      <CheckBox Content="Localhost API — other apps can send links (GET /add?url=…)"
                IsChecked="{Binding LocalApiEnabled}"
                ToolTip.Tip="Also enables single-instance: launching with a URL forwards it to the running app" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding LocalApiEnabled}">
        <NumericUpDown Minimum="1024" Maximum="65535" Increment="1" Value="{Binding LocalApiPort}" Width="150" />
        <TextBlock Text="port (default 45454)" Classes="hint" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Text="Speed test endpoint" Classes="sectionTitle" />
      <TextBox Text="{Binding SpeedTestUrl}" Watermark="empty = Cloudflare speed test (recommended)" />

      <TextBlock Text="Telemetry (Sentry)" Classes="sectionTitle" />
      <TextBox Text="{Binding SentryDsn}" Watermark="Sentry DSN"
               ToolTip.Tip="Paste a fresh DSN from Sentry → Settings → Client Keys. The shipped DSN may be stale." />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="toolbtn" Content="Send test event" Click="OnSendSentryTest" />
        <TextBlock Text="{Binding SentryTestResult}" Classes="hint" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="330" />
      </StackPanel>

      <TextBlock Text="Segment split is automatic: 8 parts below 500 MB, 16 parts above — interleaved across your Ethernet and Wi-Fi adapters."
                 Classes="hint" TextWrapping="Wrap" Margin="0,10,0,0" />

      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,14,0,4">
        <Button Content="Cancel" Classes="toolbtn" Click="OnCancel" />
        <Button Content="Save" Classes="accent" Click="OnSave" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
