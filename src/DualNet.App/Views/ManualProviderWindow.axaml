<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualNet.App.ViewModels"
        xmlns:core="using:DualNet.Core.Models"
        x:Class="DualNet.App.Views.ManualProviderWindow"
        x:DataType="vm:ManualProvidersViewModel"
        x:CompileBindings="True"
        Title="Manual network providers"
        Background="{DynamicResource DnBgBrush}"
        Width="560" Height="560" MinWidth="500" MinHeight="460"
        CanResize="True" WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto" Margin="18">

    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="10">

        <TextBlock Text="Manual network providers" FontWeight="Bold" FontSize="17" />
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="Use a manual provider when DualNet's automatic scan does not offer a network — VPN tunnels, virtual switches, multi-IP adapters or NICs without a gateway. Downloads bind directly to the IPv4 address you enter; when that IP is present on this PC the provider comes online and gets its own tab." />

        <!-- existing providers -->
        <TextBlock Text="Your providers" Classes="sectionTitle" Margin="0,6,0,0" />
        <Border Classes="card" Padding="12" IsVisible="{Binding HasProviders}">
          <ItemsControl ItemsSource="{Binding Providers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:ManualAdapterEntry">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,3">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding IPv4Address}" Classes="hint" />
                    <TextBlock Text="{Binding TypeName}" Classes="hint" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="manual" Classes="hint" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="✕" Classes="toolbtn" Padding="8,2" MinWidth="0"
                          Margin="10,0,0,0" Command="{Binding $parent[Window].DataContext.RemoveCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Remove this manual provider" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <Border Classes="card" Padding="12" IsVisible="{Binding !HasProviders}">
          <TextBlock Classes="hint" TextWrapping="Wrap"
                     Text="No manual providers yet. Auto-detected networks do not need one — they appear automatically." />
        </Border>

        <!-- add new -->
        <TextBlock Text="Add a provider" Classes="sectionTitle" Margin="0,8,0,0" />
        <Border Classes="card" Padding="12">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,110">
              <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                <TextBlock Text="Display name" Classes="hint" />
                <TextBox Text="{Binding NewName}" Watermark="e.g. Lab VPN, Home Ethernet 2" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Type" Classes="hint" />
                <ComboBox SelectedIndex="{Binding NewTypeIndex}" Width="110" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="Ethernet" />
                  <ComboBoxItem Content="Wi-Fi" />
                  <ComboBoxItem Content="Other" />
                </ComboBox>
              </StackPanel>
            </Grid>
            <StackPanel Spacing="4">
              <TextBlock Text="IPv4 address on this PC (downloads bind to it)" Classes="hint" />
              <TextBox Text="{Binding NewIp}" Watermark="e.g. 192.168.1.50" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="accent" Content="＋ Add provider" Command="{Binding AddCommand}" />
              <TextBlock Text="{Binding ValidationMessage}" Classes="hint" VerticalAlignment="Center"
                         MaxWidth="360" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
      <TextBlock Grid.Column="0" Classes="hint" VerticalAlignment="Center"
                 Text="Changes are saved immediately — the network list refreshes when you close this window." />
      <Button Grid.Column="2" Content="Close" Classes="accent" Click="OnClose" />
    </Grid>
  </Grid>
</Window>
