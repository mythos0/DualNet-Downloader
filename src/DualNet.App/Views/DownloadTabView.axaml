<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DualNet.App.ViewModels"
             xmlns:controls="using:DualNet.App.Controls"
             x:Class="DualNet.App.Views.DownloadTabView"
             x:DataType="vm:DownloadTabViewModel"
             x:CompileBindings="True">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ============ Browser-style address bar ============ -->
    <Border Grid.Row="0" Classes="urlbar" IsVisible="{Binding IsDownloadTab}">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">

        <Button Grid.Column="0" Classes="toolbtn nav" Content="◀" Command="{Binding GoBackCommand}"
                IsEnabled="{Binding CanGoBack}" ToolTip.Tip="Back — previous link" />
        <Button Grid.Column="1" Classes="toolbtn nav" Content="▶" Command="{Binding GoForwardCommand}"
                IsEnabled="{Binding CanGoForward}" ToolTip.Tip="Forward — next link" Margin="4,0,0,0" />
        <Button Grid.Column="2" Classes="toolbtn nav" Content="↻" Command="{Binding ReloadCommand}"
                CommandParameter="{Binding UrlInput}" ToolTip.Tip="Reload — re-download this link" Margin="4,0,0,0" />
        <Button Grid.Column="3" Classes="toolbtn nav" Content="⌂" Command="{Binding GoHomeCommand}"
                ToolTip.Tip="Home — clear the address bar" Margin="4,0,8,0" />

        <TextBox x:Name="AddressBox" Grid.Column="4" Classes="address"
                 Watermark="Enter a link — example.com/file.zip or https://…  (Enter ⇣, Ctrl+L)"
                 Text="{Binding UrlInput}"
                 KeyDown="OnAddressKeyDown" />

        <Button Grid.Column="5" Classes="toolbtn" Content="📋" Command="{Binding PasteFromClipboardCommand}"
                ToolTip.Tip="Paste from clipboard" Margin="8,0,0,0" />
        <Button Grid.Column="6" Classes="accent" Content="⤓ Download" Command="{Binding NavigateCommand}"
                CommandParameter="{Binding UrlInput}" ToolTip.Tip="Start downloading (Enter)" Margin="8,0,0,0" />

        <!-- Scope + quick actions row -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" ColumnDefinitions="*,Auto" Margin="2,8,0,0">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding ScopeHint}" Classes="hint" VerticalAlignment="Center" />
            <TextBlock Text="{Binding InputError}" Classes="error"
                       IsVisible="{Binding InputError, Converter={x:Static ObjectConverters.IsNotNull}}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="toolbtn mini" Content="⏸ all" Command="{Binding PauseAllCommand}"
                    ToolTip.Tip="Pause every download in this tab" />
            <Button Classes="toolbtn mini" Content="▶ all" Command="{Binding ResumeAllCommand}"
                    ToolTip.Tip="Resume paused / queued / failed downloads" />
            <Button Classes="toolbtn mini" Content="↻ failed" Command="{Binding RetryFailedCommand}"
                    ToolTip.Tip="Retry all failed downloads" />
            <Button Classes="toolbtn mini" Content="🧹 finished" Command="{Binding ClearFinishedCommand}"
                    ToolTip.Tip="Remove completed / failed / canceled entries from the list" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- History toolbar -->
    <Border Grid.Row="0" Classes="urlbar" IsVisible="{Binding IsHistoryTab}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Completed and failed downloads are recorded here."
                   Classes="hint" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="toolbtn" Content="Clear history"
                Command="{Binding ClearHistoryCommand}" />
      </Grid>
    </Border>

    <!-- Content -->
    <ScrollViewer Grid.Row="1">
      <Panel>

        <!-- ============ Browser home / start page ============ -->
        <StackPanel IsVisible="{Binding ShowHome}" HorizontalAlignment="Center"
                    Margin="0,52,0,0" Spacing="8" MaxWidth="660">
          <Border Classes="homeLogo" HorizontalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="⇊" />
          </Border>
          <TextBlock Text="DualNet Downloader" FontSize="23" FontWeight="Bold" TextAlignment="Center" />
          <TextBlock Classes="hint" TextAlignment="Center" TextWrapping="Wrap"
                     Text="Type a link in the address bar above — the file is split into segments and downloaded over your Ethernet and Wi-Fi adapters at the same time, then reassembled byte-for-byte." />
          <TextBlock Classes="hint" TextAlignment="Center" Margin="0,10,0,2"
                     IsVisible="{Binding HasRecentUrls}"
                     Text="Recent links — click to download again:" />

          <ItemsControl ItemsSource="{Binding RecentUrls}" IsVisible="{Binding HasRecentUrls}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Classes="pill" Content="{Binding}"
                        Command="{Binding $parent[ItemsControl].DataContext.NavigateCommand}"
                        CommandParameter="{Binding}"
                        Margin="3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- History empty state -->
        <TextBlock Classes="empty"
                   Text="No history yet — finished downloads appear here."
                   IsVisible="{Binding ShowHistoryEmpty}" />

        <!-- Download cards -->
        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsDownloadTab}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DownloadItemViewModel">
              <Border Classes="card" Margin="0,0,0,9">
                <Grid ColumnDefinitions="52,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">

                  <Border Grid.RowSpan="4" Width="42" Height="42" CornerRadius="13"
                          Background="{DynamicResource DnAccentSoftBrush}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding CategoryGlyph}" FontSize="19"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               ToolTip.Tip="{Binding CategoryLabel}" />
                  </Border>

                  <Grid Grid.Column="1" Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Url}" />
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="dim"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                  </Grid>

                  <ProgressBar Grid.Column="1" Grid.Row="1"
                               Value="{Binding ProgressPercent}" Maximum="100"
                               IsIndeterminate="{Binding IsIndeterminate}"
                               Height="7" Margin="0,8,0,0" />

                  <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto"
                        Margin="0,7,0,0">
                    <TextBlock Text="{Binding ProgressText}" Classes="hint" />
                    <TextBlock Grid.Column="1" Text="{Binding EtaText}" Classes="hint"
                               Margin="0,0,14,0" />
                    <TextBlock Grid.Column="2" Text="{Binding SpeedText}" Classes="hint"
                               FontWeight="SemiBold" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="3" Text="{Binding ErrorMessage}"
                               Classes="error" IsVisible="{Binding HasError}"
                               TextTrimming="CharacterEllipsis" MaxWidth="400" />
                  </Grid>

                  <TextBlock Grid.Column="1" Grid.Row="3" Classes="ok" Margin="0,5,0,0"
                             Text="SHA-256 computed &amp; copied to clipboard ✓"
                             IsVisible="{Binding HasHashText}" />

                  <StackPanel Grid.Column="2" Grid.RowSpan="4" Orientation="Horizontal"
                              Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Classes="toolbtn" Content="▲" IsVisible="{Binding CanMoveInQueue}"
                            Command="{Binding MoveUpCommand}" ToolTip.Tip="Move up in queue" />
                    <Button Classes="toolbtn" Content="▼" IsVisible="{Binding CanMoveInQueue}"
                            Command="{Binding MoveDownCommand}" ToolTip.Tip="Move down in queue" />
                    <Button Classes="toolbtn" Content="⏸" IsVisible="{Binding CanPause}"
                            Command="{Binding PauseCommand}" ToolTip.Tip="Pause" />
                    <Button Classes="toolbtn" Content="▶" IsVisible="{Binding CanResume}"
                            Command="{Binding ResumeCommand}" ToolTip.Tip="Start / Resume" />
                    <Button Classes="toolbtn" Content="✕" IsVisible="{Binding CanCancel}"
                            Command="{Binding CancelCommand}" ToolTip.Tip="Cancel and delete partial file" />
                    <Button Classes="toolbtn" Content="⤢" IsVisible="{Binding IsCompleted}"
                            Command="{Binding OpenFileCommand}" ToolTip.Tip="Open file" />
                    <Button Classes="toolbtn" Content="📁"
                            Command="{Binding OpenFolderCommand}" ToolTip.Tip="Show in folder" />
                    <Button Classes="toolbtn" Content="#" IsVisible="{Binding CanVerifyHash}"
                            Command="{Binding VerifyHashCommand}"
                            ToolTip.Tip="Verify integrity — compute SHA-256 and copy it" />
                    <Button Classes="toolbtn" Content="🔗"
                            Command="{Binding CopyUrlCommand}" ToolTip.Tip="Copy download URL" />
                    <Button Classes="toolbtn" Content="↻" IsVisible="{Binding CanRestart}"
                            Command="{Binding RestartCommand}" ToolTip.Tip="Download again from the start" />
                    <Button Classes="toolbtn" Content="🗑" IsVisible="{Binding CanRemove}"
                            Command="{Binding RemoveCommand}" ToolTip.Tip="Remove from list" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- History rows -->
        <ItemsControl ItemsSource="{Binding HistoryEntries}" IsVisible="{Binding IsHistoryTab}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryItemViewModel">
              <Border Classes="card" Margin="0,0,0,9">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Entry.Url}" />
                  <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12"
                             FontWeight="SemiBold" Foreground="{Binding StatusBrush}"
                             Margin="10,0,0,0" />
                  <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="12"
                              Margin="0,5,0,0">
                    <TextBlock Text="{Binding SizeText}" Classes="hint" />
                    <TextBlock Text="{Binding Scope}" Classes="hint" />
                    <TextBlock Text="{Binding WhenText}" Classes="hint" />
                    <TextBlock Text="{Binding Message}" Classes="error"
                               IsVisible="{Binding HasMessage}"
                               TextTrimming="CharacterEllipsis" MaxWidth="480" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </ScrollViewer>

    <!-- Per-tab speed graph + per-adapter live speeds + speed test -->
    <Border Grid.Row="2" Classes="graphbar" IsVisible="{Binding IsDownloadTab}">
      <Grid RowDefinitions="Auto" ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock Text="{Binding TabSpeedText}" FontWeight="Bold" FontSize="15" />
          <TextBlock Text="tab speed" Classes="hint" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="6">
          <controls:SpeedGraph Height="46" x:Name="Graph" />
          <TextBlock Text="{Binding SpeedTestText}" Classes="hint" TextWrapping="Wrap"
                     IsVisible="{Binding SpeedTestText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="7" VerticalAlignment="Center"
                    Margin="14,0,0,0">
          <ItemsControl ItemsSource="{Binding AdapterSpeedChips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AdapterSpeedChipViewModel">
                <Border Classes="speedChip" ToolTip.Tip="{Binding IpAddress}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SpeedText}" FontSize="11" Classes="hint"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="toolbtn mini" HorizontalAlignment="Right"
                  Content="⚡ test speed" Command="{Binding RunSpeedTestCommand}"
                  ToolTip.Tip="Measure real bandwidth through this tab's adapter(s)" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
