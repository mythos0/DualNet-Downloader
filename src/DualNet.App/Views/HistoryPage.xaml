<UserControl x:Class="DualNet.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BrushPage}" Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="History" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
            <Button DockPanel.Dock="Right" Content="Clear browsing history" HorizontalAlignment="Right" Padding="12,5" Click="Clear_Click"/>
        </DockPanel>
        <TextBox Grid.Row="1" x:Name="FilterBox" Height="30" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"
                 TextChanged="Filter_TextChanged" ToolTip="Filter by title or URL"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="10,6" Margin="0,1" Background="{DynamicResource BrushRow}" Cursor="Hand"
                                MouseUp="Item_Click" ToolTip="{Binding Url}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="700"/>
                                    <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{DynamicResource BrushTextDim}" TextTrimming="CharacterEllipsis" MaxWidth="700"/>
                                </StackPanel>
                                <TextBlock Text="{Binding WhenText}" FontSize="11" Foreground="{DynamicResource BrushTextDim}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
