<UserControl x:Class="DualNet.App.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{DynamicResource BrushPage}" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="24,30" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/app.png" Width="48" Height="48"/>
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="DualNet Downloader" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource BrushTextDim}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="EngineText" FontSize="12" Foreground="{DynamicResource BrushTextDim}" Margin="0,14,0,0" TextWrapping="Wrap"/>
            <TextBlock FontSize="12" Foreground="{DynamicResource BrushText}" Margin="0,16,0,4" Text="Highlights" FontWeight="SemiBold"/>
            <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextDim}" TextWrapping="Wrap" Text="• Full Chromium browser (CEF 138) with real Chrome extension support — uBlock Origin preinstalled&#x0a;• Per-tab proxy (free tested proxies built in) and per-tab download network selection beside the proxy icon&#x0a;• Dual-NIC download engine: Combined / single-NIC downloads, global segment queue with work stealing, adaptive scaling&#x0a;• DuckDuckGo default search, session restore, private tabs, find-in-page, zoom, screenshots, bookmarks with import/export"/>
            <TextBlock x:Name="SentryText" FontSize="11" Foreground="{DynamicResource BrushTextDim}" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
